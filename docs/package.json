{
  "name": "craftplan-docs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run generate-graphql-docs && astro build",
    "preview": "astro preview",
    "generate-spec": "cd .. && mix run docs/generate_spec.exs",
    "generate-sdl": "cd .. && mix run docs/generate_sdl.exs",
    "generate-graphql-docs": "spectaql spectaql.yml",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@scalar/astro": "0.4.33",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "graphql": "16.13.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "spectaql": "3.0.9"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
